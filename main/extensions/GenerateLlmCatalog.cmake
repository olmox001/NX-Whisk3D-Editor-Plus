if(NOT DEFINED INPUT_DIR OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "GenerateLlmCatalog.cmake requires INPUT_DIR and OUTPUT")
endif()

file(GLOB _files "${INPUT_DIR}/*.cpp")
set(_commands)
foreach(_file IN LISTS _files)
    file(READ "${_file}" _src)
    string(REGEX MATCHALL "cmd[ \t\r\n]*==[ \t\r\n]*\"[^\"]+\"" _matches "${_src}")
    foreach(_match IN LISTS _matches)
        string(REGEX REPLACE ".*\"([^\"]+)\".*" "\\1" _name "${_match}")
        list(APPEND _commands "${_name}")
    endforeach()
endforeach()

list(REMOVE_DUPLICATES _commands)
list(SORT _commands)
list(LENGTH _commands _count)

# Collect up to two real examples per command from the existing .w3s suite.
# This is documentation only: the test scripts are never modified.
get_filename_component(_main_dir "${INPUT_DIR}" DIRECTORY)
get_filename_component(_root_dir "${_main_dir}" DIRECTORY)
file(GLOB _scripts "${_root_dir}/tools/pruebas/*.w3s")
foreach(_script IN LISTS _scripts)
    file(STRINGS "${_script}" _lines)
    foreach(_line IN LISTS _lines)
        string(STRIP "${_line}" _trim)
        if(_trim STREQUAL "" OR _trim MATCHES "^#")
            continue()
        endif()
        string(REGEX MATCH "^([A-Za-z0-9_]+)" _head "${_trim}")
        if(NOT _head)
            continue()
        endif()
        set(_cmd "${CMAKE_MATCH_1}")
        list(FIND _commands "${_cmd}" _idx)
        if(_idx EQUAL -1)
            continue()
        endif()
        set(_var "_ex_${_cmd}")
        set(_vals "${${_var}}")
        list(FIND _vals "${_trim}" _dup)
        list(LENGTH _vals _n)
        if(_dup EQUAL -1 AND _n LESS 2)
            list(APPEND _vals "${_trim}")
            set("${_var}" "${_vals}")
        endif()
    endforeach()
endforeach()

function(_w3d_escape _in _out)
    set(_s "${_in}")
    string(REPLACE "\\" "\\\\" _s "${_s}")
    string(REPLACE "\"" "\\\"" _s "${_s}")
    string(REPLACE "\n" "\\n" _s "${_s}")
    set("${_out}" "${_s}" PARENT_SCOPE)
endfunction()

get_filename_component(_out_dir "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_out_dir}")
file(WRITE "${OUTPUT}"
"// Generated from main/test/*.cpp and tools/pruebas/*.w3s. Do not edit.\n"
"struct W3dGeneratedCommandInfo { const char* name; const char* example1; const char* example2; };\n"
"static const W3dGeneratedCommandInfo kW3dGeneratedCommands[] = {\n")
foreach(_cmd IN LISTS _commands)
    set(_vals "${_ex_${_cmd}}")
    list(LENGTH _vals _n)
    set(_e1 "")
    set(_e2 "")
    if(_n GREATER 0)
        list(GET _vals 0 _e1)
    endif()
    if(_n GREATER 1)
        list(GET _vals 1 _e2)
    endif()
    _w3d_escape("${_cmd}" _c)
    _w3d_escape("${_e1}" _a)
    _w3d_escape("${_e2}" _b)
    file(APPEND "${OUTPUT}" "    {\"${_c}\", \"${_a}\", \"${_b}\"},\n")
endforeach()
file(APPEND "${OUTPUT}"
"};\n"
"static const unsigned kW3dGeneratedCommandCount = ${_count}u;\n")
